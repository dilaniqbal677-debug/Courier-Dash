rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hardened helper functions
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidScore(data) {
      return data.userId is string && data.userId.size() <= 128
          && data.username is string && data.username.size() <= 50
          && data.score is number
          && data.createdAt == request.time;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Scores collection
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if isSignedIn() 
                    && isValidId(scoreId)
                    && isValidScore(incoming())
                    && incoming().userId == request.auth.uid;
      allow update, delete: if false; // Immutable scores
    }
  }
}
